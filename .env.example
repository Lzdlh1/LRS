# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，禁止提交。
# 本文件只放占位符，任何真实 Key 都不允许写进来。

# ── LLM 供应商密钥（M3 阶段接入 llm-router 时使用）──
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 模型分级路由：cheap / strong 两档分别指向谁 ──
LLM_CHEAP_PROVIDER=deepseek
LLM_CHEAP_MODEL=deepseek-chat
LLM_STRONG_PROVIDER=deepseek
LLM_STRONG_MODEL=deepseek-reasoner

# ── 服务端 ──
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# ── 日志 ──
# debug | info | warn | error
LOG_LEVEL=info
# 是否把 prompt 全文落盘。默认 false，只有排查问题时才临时开启。
LOG_PROMPTS=false
# 日志保留天数
LOG_RETENTION_DAYS=7
