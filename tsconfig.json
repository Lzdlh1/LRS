{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@lrs/shared": ["./packages/shared/src/index.ts"],
      "@lrs/core-engine": ["./packages/core-engine/src/index.ts"],
      "@lrs/llm-router": ["./packages/llm-router/src/index.ts"],
      "@lrs/agent-host": ["./packages/agent-host/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["packages/web/**"]
}
